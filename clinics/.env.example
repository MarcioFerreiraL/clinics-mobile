# Variáveis de build do app. Copie para `.env` e ajuste.
# Uso: flutter run --dart-define-from-file=.env
#      flutter build apk --dart-define-from-file=.env
# O `.env` NUNCA vai para o Git. Aqui só ficam valores de exemplo.

# URL base da API (sem /api/v1):
#   emulador Android -> http://10.0.2.2:8080
#   celular na mesma rede Wi-Fi -> http://IP_DO_COMPUTADOR:8080
#   produção (Cloudflare Tunnel) -> https://api.seudominio.com
API_BASE_URL=http://10.0.2.2:8080
